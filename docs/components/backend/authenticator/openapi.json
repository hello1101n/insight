{
  "components": {
    "schemas": {
      "CreatedSqlToken": {
        "properties": {
          "created_at": {
            "type": "string"
          },
          "expires_at": {
            "type": "string"
          },
          "label": {
            "type": "string"
          },
          "person_id": {
            "type": "string"
          },
          "token": {
            "description": "Shown in this response only; the service keeps its hash.",
            "type": "string"
          },
          "token_id": {
            "type": "string"
          }
        },
        "required": [
          "token_id",
          "token",
          "person_id",
          "label",
          "created_at",
          "expires_at"
        ],
        "type": "object"
      },
      "Problem": {
        "description": "RFC 9457 problem+json. `context` varies by error category.",
        "properties": {
          "context": {
            "type": "object"
          },
          "detail": {
            "type": "string"
          },
          "instance": {
            "type": "string"
          },
          "status": {
            "format": "int32",
            "type": "integer"
          },
          "title": {
            "type": "string"
          },
          "trace_id": {
            "type": "string"
          },
          "type": {
            "type": "string"
          }
        },
        "required": [
          "type",
          "title",
          "status",
          "detail",
          "context"
        ],
        "type": "object"
      },
      "SqlTokenEntry": {
        "properties": {
          "created_at": {
            "type": "string"
          },
          "created_by": {
            "$ref": "#/components/schemas/SqlTokenPerson"
          },
          "expires_at": {
            "type": "string"
          },
          "label": {
            "type": "string"
          },
          "person": {
            "$ref": "#/components/schemas/SqlTokenPerson"
          },
          "token_id": {
            "type": "string"
          }
        },
        "required": [
          "token_id",
          "label",
          "created_at",
          "expires_at",
          "person",
          "created_by"
        ],
        "type": "object"
      },
      "SqlTokenListResponse": {
        "properties": {
          "items": {
            "items": {
              "$ref": "#/components/schemas/SqlTokenEntry"
            },
            "type": "array"
          }
        },
        "required": [
          "items"
        ],
        "type": "object"
      },
      "SqlTokenPerson": {
        "properties": {
          "display_name": {
            "type": "string"
          },
          "email": {
            "type": [
              "string",
              "null"
            ]
          },
          "person_id": {
            "type": "string"
          },
          "username": {
            "type": "string"
          }
        },
        "required": [
          "person_id",
          "display_name",
          "username"
        ],
        "type": "object"
      },
      "SqlTokenRequest": {
        "properties": {
          "label": {
            "type": "string"
          },
          "lifetime_days": {
            "default": 365,
            "format": "int64",
            "maximum": 730,
            "minimum": 1,
            "type": [
              "integer",
              "null"
            ]
          },
          "person_id": {
            "format": "uuid",
            "type": "string"
          }
        },
        "required": [
          "person_id",
          "label"
        ],
        "type": "object"
      }
    },
    "securitySchemes": {
      "bearerAuth": {
        "bearerFormat": "JWT",
        "scheme": "bearer",
        "type": "http"
      },
      "internalToken": {
        "description": "Platform-plane workload credential, validated by the receiving listener",
        "in": "header",
        "name": "x-toolkit-internal-token",
        "type": "apiKey"
      }
    }
  },
  "info": {
    "description": "OIDC login, opaque sessions, and the cookie-to-JWT exchange behind the nginx gateway (the BFF / token-handler pattern). The gateway proxies /auth/* to this service and calls /internal/authz as its auth_request target; /.well-known/* serves the discovery document and JWKS downstream verifiers consume.",
    "title": "Authenticator API",
    "version": "1.0.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/.well-known/jwks.json": {
      "get": {
        "operationId": "authenticator.jwks",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            },
            "description": "JWKS document"
          }
        },
        "summary": "Public JWKS for gateway-JWT verification",
        "tags": [
          "internal"
        ],
        "x-toolkit-visibility": "exposed"
      }
    },
    "/.well-known/oauth-authorization-server": {
      "get": {
        "operationId": "authenticator.mcp_oauth.metadata",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            },
            "description": "Authorization server metadata"
          }
        },
        "summary": "OAuth authorization server metadata for MCP clients",
        "tags": [
          "mcp-oauth"
        ],
        "x-toolkit-visibility": "exposed"
      }
    },
    "/.well-known/oauth-protected-resource": {
      "get": {
        "operationId": "authenticator.mcp_oauth.protected_resource",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            },
            "description": "Protected resource metadata"
          }
        },
        "summary": "Protected resource metadata for the MCP endpoint",
        "tags": [
          "mcp-oauth"
        ],
        "x-toolkit-visibility": "exposed"
      }
    },
    "/.well-known/oauth-protected-resource/mcp": {
      "get": {
        "operationId": "authenticator.mcp_oauth.protected_resource_mcp",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            },
            "description": "Protected resource metadata"
          }
        },
        "summary": "Path-specific protected resource metadata for the MCP endpoint",
        "tags": [
          "mcp-oauth"
        ],
        "x-toolkit-visibility": "exposed"
      }
    },
    "/.well-known/oauth-protected-resource/mcp/v3": {
      "get": {
        "operationId": "authenticator.mcp_oauth.protected_resource_mcp_v3",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            },
            "description": "Protected resource metadata"
          }
        },
        "summary": "Protected resource metadata for the custom-surface MCP endpoint",
        "tags": [
          "mcp-oauth"
        ],
        "x-toolkit-visibility": "exposed"
      }
    },
    "/.well-known/openid-configuration": {
      "get": {
        "operationId": "authenticator.openid_configuration",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            },
            "description": "OIDC discovery document"
          }
        },
        "summary": "OIDC discovery document (issuer + jwks_uri) for downstream verifiers",
        "tags": [
          "internal"
        ],
        "x-toolkit-visibility": "exposed"
      }
    },
    "/auth/admin/users/{person_id}/sessions": {
      "delete": {
        "operationId": "authenticator.sessions.admin_revoke_by_user",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            },
            "description": "Revocation result"
          },
          "401": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "Unauthorized"
          },
          "403": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "Forbidden"
          }
        },
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "summary": "Revoke every session of a user (admin/service, gateway-JWT authenticated)",
        "tags": [
          "auth"
        ]
      }
    },
    "/auth/callback": {
      "get": {
        "operationId": "authenticator.callback",
        "responses": {
          "302": {
            "description": "Redirect to the SPA: with the session cookie set on success, or with `auth_error=<reason>` (state_expired, idp_error, invalid_callback, exchange_failed, access_denied) on a failed login so the SPA can restart the flow"
          }
        },
        "summary": "Complete login: exchange the code and set the session cookie",
        "tags": [
          "auth"
        ],
        "x-toolkit-visibility": "exposed"
      }
    },
    "/auth/csrf": {
      "get": {
        "operationId": "authenticator.csrf",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            },
            "description": "CSRF token"
          },
          "401": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "Unauthorized"
          }
        },
        "summary": "Issue the CSRF token bound to the current session",
        "tags": [
          "auth"
        ],
        "x-toolkit-visibility": "exposed"
      }
    },
    "/auth/login": {
      "get": {
        "operationId": "authenticator.login",
        "responses": {
          "302": {
            "description": "Redirect to the IdP authorize endpoint"
          },
          "403": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "Forbidden"
          }
        },
        "summary": "Start the OIDC code+PKCE login flow (the request Host selects the issuer)",
        "tags": [
          "auth"
        ],
        "x-toolkit-visibility": "exposed"
      }
    },
    "/auth/logout": {
      "post": {
        "operationId": "authenticator.logout",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            },
            "description": "RP-logout URL"
          }
        },
        "summary": "Revoke the session, clear the cookie, return the RP-logout URL",
        "tags": [
          "auth"
        ],
        "x-toolkit-visibility": "exposed"
      }
    },
    "/auth/me": {
      "get": {
        "operationId": "authenticator.me",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            },
            "description": "Session summary"
          },
          "401": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "Unauthorized"
          }
        },
        "summary": "Current session summary for the SPA",
        "tags": [
          "auth"
        ],
        "x-toolkit-visibility": "exposed"
      }
    },
    "/auth/oauth/authorize": {
      "get": {
        "operationId": "authenticator.mcp_oauth.authorize",
        "responses": {
          "200": {
            "content": {
              "text/html": {
                "schema": {
                  "format": "text/html",
                  "type": "string"
                }
              }
            },
            "description": "Authorization confirmation"
          }
        },
        "summary": "Authorize an MCP client with code and PKCE",
        "tags": [
          "mcp-oauth"
        ],
        "x-toolkit-visibility": "exposed"
      }
    },
    "/auth/oauth/decision": {
      "post": {
        "operationId": "authenticator.mcp_oauth.decision",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            },
            "description": "Client redirect"
          }
        },
        "summary": "Approve or deny a pending MCP authorization",
        "tags": [
          "mcp-oauth"
        ],
        "x-toolkit-visibility": "exposed"
      }
    },
    "/auth/oauth/register": {
      "post": {
        "operationId": "authenticator.mcp_oauth.register",
        "responses": {
          "201": {
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            },
            "description": "Registered client"
          }
        },
        "summary": "Register a public MCP OAuth client",
        "tags": [
          "mcp-oauth"
        ],
        "x-toolkit-visibility": "exposed"
      }
    },
    "/auth/oauth/revoke": {
      "post": {
        "operationId": "authenticator.mcp_oauth.revoke",
        "responses": {
          "200": {
            "description": "Token revoked"
          }
        },
        "summary": "Revoke an MCP refresh token",
        "tags": [
          "mcp-oauth"
        ],
        "x-toolkit-visibility": "exposed"
      }
    },
    "/auth/oauth/token": {
      "post": {
        "operationId": "authenticator.mcp_oauth.token",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            },
            "description": "OAuth token response"
          }
        },
        "summary": "Exchange an authorization code or refresh token",
        "tags": [
          "mcp-oauth"
        ],
        "x-toolkit-visibility": "exposed"
      }
    },
    "/auth/oidc/back-channel-logout": {
      "post": {
        "operationId": "authenticator.back_channel_logout",
        "responses": {
          "200": {
            "description": "Logout processed (or idempotent replay)"
          },
          "400": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "Bad Request"
          }
        },
        "summary": "Receive IdP back-channel logout tokens (OIDC BCL 1.0)",
        "tags": [
          "auth"
        ],
        "x-toolkit-visibility": "exposed"
      }
    },
    "/auth/refresh": {
      "post": {
        "operationId": "authenticator.refresh",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            },
            "description": "{expires_at, refresh_at} + re-issued cookie"
          },
          "401": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "Unauthorized"
          }
        },
        "summary": "Rotate the session cookie and extend the session (grace-tolerant)",
        "tags": [
          "auth"
        ],
        "x-toolkit-visibility": "exposed"
      }
    },
    "/auth/sessions": {
      "delete": {
        "operationId": "authenticator.sessions.revoke_all",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            },
            "description": "Revocation result"
          },
          "401": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "Unauthorized"
          }
        },
        "summary": "Revoke all sessions of the current user (log out everywhere)",
        "tags": [
          "auth"
        ],
        "x-toolkit-visibility": "exposed"
      },
      "get": {
        "operationId": "authenticator.sessions.list",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            },
            "description": "Active sessions"
          },
          "401": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "Unauthorized"
          }
        },
        "summary": "List the current user's active sessions",
        "tags": [
          "auth"
        ],
        "x-toolkit-visibility": "exposed"
      }
    },
    "/auth/sessions/{session_id}": {
      "delete": {
        "operationId": "authenticator.sessions.revoke",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            },
            "description": "Revocation result"
          },
          "401": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "Unauthorized"
          },
          "404": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "Not Found"
          }
        },
        "summary": "Revoke one of the current user's sessions",
        "tags": [
          "auth"
        ],
        "x-toolkit-visibility": "exposed"
      }
    },
    "/internal/authz": {
      "get": {
        "operationId": "authenticator.authz",
        "responses": {
          "200": {
            "description": "JWT attached via X-Gateway-Jwt"
          },
          "401": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "Unauthorized"
          }
        },
        "summary": "Exchange the session cookie for the linked gateway JWT",
        "tags": [
          "internal"
        ],
        "x-toolkit-visibility": "exposed"
      }
    },
    "/internal/sql-token/authz": {
      "get": {
        "operationId": "authenticator.sql_token_authz",
        "responses": {
          "200": {
            "description": "JWT attached via X-Gateway-Jwt"
          },
          "401": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "Unauthorized"
          },
          "503": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "Service Unavailable"
          }
        },
        "summary": "Exchange a personal SQL token for a SQL API JWT",
        "tags": [
          "internal"
        ],
        "x-toolkit-visibility": "exposed"
      }
    },
    "/v1/sql-tokens": {
      "get": {
        "operationId": "authenticator.sql_tokens.list",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SqlTokenListResponse"
                }
              }
            },
            "description": "At most 1000 tokens, newest first; never the token itself"
          },
          "401": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "Unauthorized"
          },
          "403": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "Forbidden"
          },
          "500": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "Internal Server Error"
          },
          "503": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "Service Unavailable"
          }
        },
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "summary": "Personal SQL API tokens of the caller's tenant",
        "tags": [
          "sql-tokens"
        ]
      },
      "post": {
        "operationId": "authenticator.sql_tokens.create",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SqlTokenRequest"
              }
            }
          },
          "description": "Who the token is for",
          "required": true
        },
        "responses": {
          "201": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CreatedSqlToken"
                }
              }
            },
            "description": "The token, shown this once"
          },
          "400": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "Bad Request"
          },
          "401": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "Unauthorized"
          },
          "403": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "Forbidden"
          },
          "415": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "Unsupported Media Type"
          },
          "500": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "Internal Server Error"
          },
          "503": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "Service Unavailable"
          }
        },
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "summary": "Create a personal SQL API token",
        "tags": [
          "sql-tokens"
        ]
      }
    },
    "/v1/sql-tokens/{token_id}": {
      "delete": {
        "operationId": "authenticator.sql_tokens.remove",
        "parameters": [
          {
            "description": "Token id from the list",
            "in": "path",
            "name": "token_id",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "204": {
            "description": "Removed"
          },
          "401": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "Unauthorized"
          },
          "403": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "Forbidden"
          },
          "404": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "Not Found"
          },
          "500": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
