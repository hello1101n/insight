map $sent_http_content_type $csp_header {
    default "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self' data:; connect-src 'self' ${SENTRY_CONNECT_SRC}; frame-src 'self'; frame-ancestors 'self'; base-uri 'self'; form-action 'self'; object-src 'none'";
}

server {
    listen 8080;
    root /usr/share/nginx/html;
    index index.html;

    gzip on;
    gzip_types text/plain text/css application/json application/javascript text/xml;
    gzip_min_length 256;

    # WORKAROUND: a location that sets its own add_header drops the server's, so each one re-includes these.
    # WORKAROUND: React and recharts set inline styles, so style-src needs 'unsafe-inline'.
    include /etc/nginx/snippets/security-headers.conf;

    location = /mockServiceWorker.js {
        return 404;
    }

    location / {
        try_files $uri $uri/ /index.html;
        add_header Cache-Control "no-cache" always;
        include /etc/nginx/snippets/security-headers.conf;
    }

    location = /config.js {
        add_header Cache-Control "no-cache" always;
        include /etc/nginx/snippets/security-headers.conf;
    }

    location ^~ /assets/ {
        # WORKAROUND: without `always` nginx sends this on 2xx/3xx only, keeping it off a mid-rollout 404.
        add_header Cache-Control "public, max-age=31536000, immutable";
        include /etc/nginx/snippets/security-headers.conf;
    }

    location /healthz {
        access_log off;
        default_type text/plain;
        return 200 "ok";
    }
}
