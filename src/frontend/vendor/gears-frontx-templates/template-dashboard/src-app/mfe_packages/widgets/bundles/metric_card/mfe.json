{
  "manifest": {
    "id": "gts.frontx.mfes.mfe.mf_manifest.v1~frontx.dashboard.widgets.metric_card.v1",
    "remoteEntry": "/widgets/metric_card/remoteEntry.js"
  },
  "entries": [
    {
      "id": "gts.frontx.mfes.mfe.entry.v1~frontx.mfes.mfe.entry_mf.v1~frontx.dashboard.mfe.metric_card.v1",
      "requiredProperties": [
        "gts.frontx.mfes.comm.shared_property.v1~frontx.mfes.comm.theme.v1~",
        "gts.frontx.mfes.comm.shared_property.v1~frontx.mfes.comm.language.v1~"
      ],
      "actions": [
        "gts.frontx.mfes.comm.action.v1~frontx.dashboard.mfe.render_widget.v1~"
      ],
      "domainActions": [],
      "manifest": "gts.frontx.mfes.mfe.mf_manifest.v1~frontx.dashboard.widgets.metric_card.v1",
      "exposedModule": "./metric_card"
    }
  ],
  "extensions": [],
  "schemas": [
    {
      "$id": "gts://gts.frontx.dashboard.widget_data.widget_data.v1~frontx.dashboard.widget_data.metric_card.v1~",
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "title": "MetricCardData",
      "description": "Data of a metric_card widget.",
      "allOf": [
        {
          "$ref": "gts://gts.frontx.dashboard.widget_data.widget_data.v1~"
        },
        {
          "type": "object",
          "required": [
            "value"
          ],
          "properties": {
            "value": {
              "type": [
                "number",
                "null"
              ]
            },
            "previous_value": {
              "type": [
                "number",
                "null"
              ]
            },
            "sparkline": {
              "type": "array",
              "items": {
                "type": [
                  "number",
                  "null"
                ]
              }
            },
            "reference_value": {
              "type": [
                "number",
                "null"
              ],
              "description": "Optional value the headline is compared with, such as last week's, shown under it with the difference: absolute, and in percent when the reference is not 0. The difference is coloured by the render's better rule, as the trend is. Absent or null shows no comparison."
            }
          }
        }
      ],
      "unevaluatedProperties": false
    },
    {
      "$id": "gts://gts.frontx.dashboard.widget.render.v1~frontx.dashboard.widget.metric_card_render.v1~",
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "title": "MetricCardRender",
      "description": "Render of a metric_card widget: its presentation fields, closed.",
      "allOf": [
        {
          "$ref": "gts://gts.frontx.dashboard.widget.render.v1~"
        },
        {
          "type": "object",
          "properties": {
            "value_label": {
              "type": "string",
              "description": "Optional caption of the headline value. Without it, no caption shows."
            },
            "better": {
              "enum": [
                "higher",
                "lower",
                "neutral"
              ],
              "default": "higher",
              "description": "Optional direction of an improvement, which sets the trend's colour: higher (the default) paints a rise as success and a fall as danger; lower paints a fall as success and a rise as danger, for numbers where less is better such as lead time; neutral paints every change in the neutral (secondary) badge, for numbers where neither direction is better. The icon and its accessible name always follow the value's own direction."
            },
            "reference_label": {
              "type": "string",
              "description": "Optional name of reference_value, such as Last week, written before it. Without it, Reference."
            },
            "link": {
              "type": "object",
              "required": [
                "text",
                "href"
              ],
              "additionalProperties": false,
              "properties": {
                "text": {
                  "type": "string",
                  "description": "The link's text."
                },
                "href": {
                  "type": "string",
                  "description": "The link's target, checked by the shared link rule: https, http, mailto, or a path from the site root (/x, not //x). Any other target shows the text alone. A link to another origin opens in a new tab."
                }
              },
              "description": "Optional link at the card's foot."
            }
          }
        }
      ],
      "unevaluatedProperties": false
    },
    {
      "$id": "gts://gts.frontx.dashboard.widget.widget.v1~frontx.dashboard.widget.data_widget.v1~frontx.dashboard.widget.metric_card.v1~",
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "title": "MetricCard",
      "x-gts-traits": {
        "entry": "gts.frontx.mfes.mfe.entry.v1~frontx.mfes.mfe.entry_mf.v1~frontx.dashboard.mfe.metric_card.v1",
        "data_type": "gts.frontx.dashboard.widget_data.widget_data.v1~frontx.dashboard.widget_data.metric_card.v1~"
      },
      "allOf": [
        {
          "$ref": "gts://gts.frontx.dashboard.widget.widget.v1~frontx.dashboard.widget.data_widget.v1~"
        },
        {
          "type": "object",
          "properties": {
            "render": {
              "$ref": "gts://gts.frontx.dashboard.widget.render.v1~frontx.dashboard.widget.metric_card_render.v1~"
            }
          }
        }
      ],
      "unevaluatedProperties": false
    }
  ]
