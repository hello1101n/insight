  "extensions": [],
  "schemas": [
    {
      "$id": "gts://gts.frontx.dashboard.widget_data.widget_data.v1~frontx.dashboard.widget_data.funnel_chart.v1~",
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "title": "FunnelChartData",
      "description": "Data of a funnel_chart widget: the stages of a process, each with how many items reached it.",
      "allOf": [
        {
          "$ref": "gts://gts.frontx.dashboard.widget_data.widget_data.v1~"
        },
        {
          "type": "object",
          "required": [
            "stages"
          ],
          "properties": {
            "stages": {
              "type": "array",
              "minItems": 1,
              "maxItems": 12,
              "description": "One to twelve stages in the delivered order, from the first step of the process to the last. All values zero or null shows the empty state.",
              "items": {
                "type": "object",
                "required": [
                  "label",
                  "value"
                ],
                "additionalProperties": false,
                "properties": {
                  "label": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 80,
                    "description": "The name of the stage."
                  },
                  "value": {
                    "type": [
                      "number",
                      "null"
                    ],
                    "description": "How many items reached the stage; at or above 0 (a negative one fails the cell, naming the stage's position, a cross-check the widget runs). A stage larger than the one before is drawn wider, and its conversion reads above 100%. Null draws an empty stage with a hyphen, and neither it nor the next stage shows a conversion."
                  }
                }
              }
            }
          }
        }
      ],
      "unevaluatedProperties": false
    },
    {
      "$id": "gts://gts.frontx.dashboard.widget.render.v1~frontx.dashboard.widget.funnel_chart_render.v1~",
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "title": "FunnelChartRender",
      "description": "Render of a funnel_chart widget: its presentation fields, closed.",
      "allOf": [
        {
          "$ref": "gts://gts.frontx.dashboard.widget.render.v1~"
        },
        {
          "type": "object",
          "properties": {
            "show_conversion": {
              "type": "boolean",
              "default": true,
              "description": "Whether each stage after the first shows its value over the previous stage's value as a percent, in its text line while its label keeps at least 3 em beside it (the tooltip, text alternative and data view always); the first stage shows none, and a stage after a previous value of 0 or null, or with a null value, shows a hyphen. Without it, true."
            },
            "value_labels": {
              "enum": [
                "auto",
                "always",
                "never"
              ],
              "default": "auto",
              "description": "Whether each stage writes its value, formatted by value_format: auto when the stage's label, value and conversion fit its width together (estimated from their lengths), and never in a low cell; always, the conversion and then the label giving way; never. Without it, auto."
            },
            "drill_down": {
              "type": "boolean",
              "default": false,
              "description": "Whether the chart offers its data view and opens it from a click on a stage. Without it, false."
            }
          }
        }
      ],
      "unevaluatedProperties": false
    },
    {
      "$id": "gts://gts.frontx.dashboard.widget.widget.v1~frontx.dashboard.widget.data_widget.v1~frontx.dashboard.widget.funnel_chart.v1~",
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "title": "FunnelChart",
      "x-gts-traits": {
        "entry": "gts.frontx.mfes.mfe.entry.v1~frontx.mfes.mfe.entry_mf.v1~frontx.dashboard.mfe.funnel_chart.v1",
        "data_type": "gts.frontx.dashboard.widget_data.widget_data.v1~frontx.dashboard.widget_data.funnel_chart.v1~"
      },
      "allOf": [
        {
          "$ref": "gts://gts.frontx.dashboard.widget.widget.v1~frontx.dashboard.widget.data_widget.v1~"
        },
        {
          "type": "object",
          "properties": {
            "render": {
              "$ref": "gts://gts.frontx.dashboard.widget.render.v1~frontx.dashboard.widget.funnel_chart_render.v1~"
            }
          }
        }
      ],
      "unevaluatedProperties": false
    }
  ]
}
