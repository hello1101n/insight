{
  "manifest": {
    "id": "gts.frontx.mfes.mfe.mf_manifest.v1~frontx.dashboard.widgets.heatmap.v1",
    "remoteEntry": "/widgets/heatmap/remoteEntry.js"
  },
  "entries": [
    {
      "id": "gts.frontx.mfes.mfe.entry.v1~frontx.mfes.mfe.entry_mf.v1~frontx.dashboard.mfe.heatmap.v1",
      "requiredProperties": [
        "gts.frontx.mfes.comm.shared_property.v1~frontx.mfes.comm.theme.v1~",
        "gts.frontx.mfes.comm.shared_property.v1~frontx.mfes.comm.language.v1~"
      ],
      "actions": [
        "gts.frontx.mfes.comm.action.v1~frontx.dashboard.mfe.render_widget.v1~"
      ],
      "domainActions": [],
      "manifest": "gts.frontx.mfes.mfe.mf_manifest.v1~frontx.dashboard.widgets.heatmap.v1",
      "exposedModule": "./heatmap"
    }
  ],
  "extensions": [],
  "schemas": [
    {
      "$id": "gts://gts.frontx.dashboard.widget_data.widget_data.v1~frontx.dashboard.widget_data.heatmap.v1~",
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "title": "HeatmapData",
      "description": "Data of a heatmap widget.",
      "allOf": [
        {
          "$ref": "gts://gts.frontx.dashboard.widget_data.widget_data.v1~"
        },
        {
          "type": "object",
          "required": [
            "rows"
          ],
          "properties": {
            "rows": {
              "type": "array",
              "description": "One row per cell value. An omitted y counts as null.",
              "items": {
                "type": "object",
                "required": [
                  "x",
                  "value"
                ],
                "additionalProperties": false,
                "properties": {
                  "x": {
                    "type": [
                      "string",
                      "number",
                      "null"
                    ]
                  },
                  "y": {
                    "type": [
                      "string",
                      "number",
                      "null"
                    ]
                  },
                  "value": {
                    "type": [
                      "number",
                      "null"
                    ]
                  }
                }
              }
            }
          }
        }
      ],
      "unevaluatedProperties": false
    },
    {
      "$id": "gts://gts.frontx.dashboard.widget.render.v1~frontx.dashboard.widget.heatmap_render.v1~",
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "title": "HeatmapRender",
      "description": "Render of a heatmap widget: its presentation fields, closed.",
      "allOf": [
        {
          "$ref": "gts://gts.frontx.dashboard.widget.render.v1~"
        },
        {
          "type": "object",
          "properties": {
            "x_axis_label": {
              "type": "string",
              "description": "Optional x-axis title."
            },
            "y_axis_label": {
              "type": "string",
              "description": "Optional y-axis title."
            },
            "min_value": {
              "type": [
                "number",
                "null"
              ],
              "description": "Optional lower end of the colour scale. Null or absent takes the lowest value in the rows. When both ends are set, it is not greater than max_value (a cross-check the widget runs, cpt-frontx-dashboard-algo-widget-catalog-heatmap-checks)."
            },
            "max_value": {
              "type": [
                "number",
                "null"
              ],
              "description": "Optional upper end of the colour scale. Null or absent takes the highest value in the rows."
            },
            "show_cell_values": {
              "type": "boolean",
              "description": "Whether to show each cell's value inside the cell."
            },
            "mode": {
              "enum": [
                "matrix",
                "calendar"
              ],
              "default": "matrix",
              "description": "matrix draws the x categories by the y categories. calendar draws one tile per day: a column per week, a row per weekday, the month names over the columns; every row's x is then a YYYY-MM-DD date and its y is omitted or null (a cross-check the widget runs, cpt-frontx-dashboard-algo-widget-catalog-heatmap-checks). Without it, matrix."
            },
            "week_start": {
              "enum": [
                "monday",
                "sunday"
              ],
              "default": "monday",
              "description": "Calendar mode only: the weekday each week column starts on. Set with the matrix mode, it fails the widget's cross-check. Without it, monday."
            },
            "drill_down": {
              "type": "boolean",
              "default": false,
              "description": "Whether the heatmap offers its data view and opens it from a click on a tile; the tiles are then buttons. Without it, false."
            }
          }
        }
      ],
      "unevaluatedProperties": false
    },
    {
      "$id": "gts://gts.frontx.dashboard.widget.widget.v1~frontx.dashboard.widget.data_widget.v1~frontx.dashboard.widget.heatmap.v1~",
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "title": "Heatmap",
      "x-gts-traits": {
        "entry": "gts.frontx.mfes.mfe.entry.v1~frontx.mfes.mfe.entry_mf.v1~frontx.dashboard.mfe.heatmap.v1",
        "data_type": "gts.frontx.dashboard.widget_data.widget_data.v1~frontx.dashboard.widget_data.heatmap.v1~"
      },
      "allOf": [
        {
          "$ref": "gts://gts.frontx.dashboard.widget.widget.v1~frontx.dashboard.widget.data_widget.v1~"
        },
        {
          "type": "object",
          "properties": {
            "render": {
              "$ref": "gts://gts.frontx.dashboard.widget.render.v1~frontx.dashboard.widget.heatmap_render.v1~"
            }
          }
        }
      ],
      "unevaluatedProperties": false
    }
  ]
}
