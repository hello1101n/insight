  "extensions": [],
  "schemas": [
    {
      "$id": "gts://gts.frontx.dashboard.widget_data.widget_data.v1~frontx.dashboard.widget_data.radar_chart.v1~",
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "title": "RadarChartData",
      "description": "Data of a radar_chart widget: the values of the series on the axes, in the long format.",
      "allOf": [
        {
          "$ref": "gts://gts.frontx.dashboard.widget_data.widget_data.v1~"
        },
        {
          "type": "object",
          "required": [
            "points"
          ],
          "properties": {
            "points": {
              "type": "array",
              "minItems": 3,
              "maxItems": 120,
              "description": "Three to 120 points in the delivered order. The widget shows 3 to 12 distinct axes and at most 5 distinct series, one per tone of the kit palette, and fails the cell outside them (a cross-check it runs, cpt-frontx-dashboard-algo-widget-catalog-card-checks).",
              "items": {
                "type": "object",
                "required": [
                  "axis",
                  "series",
                  "value"
                ],
                "additionalProperties": false,
                "properties": {
                  "axis": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 40
                  },
                  "series": {
                    "type": [
                      "string",
                      "null"
                    ],
                    "minLength": 1,
                    "maxLength": 40,
                    "description": "The name of the series, or null for the one unnamed series."
                  },
                  "value": {
                    "type": [
                      "number",
                      "null"
                    ]
                  }
                }
              }
            }
          }
        }
      ],
      "unevaluatedProperties": false
    },
    {
      "$id": "gts://gts.frontx.dashboard.widget.render.v1~frontx.dashboard.widget.radar_chart_render.v1~",
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "title": "RadarChartRender",
      "description": "Render of a radar_chart widget: its presentation fields, closed.",
      "allOf": [
        {
          "$ref": "gts://gts.frontx.dashboard.widget.render.v1~"
        },
        {
          "type": "object",
          "properties": {
            "scale_max": {
              "type": "number",
              "exclusiveMinimum": 0,
              "description": "Optional value the outer circle stands for at least: a larger delivered value extends the circle to that value. Without it, the largest delivered value, rounded up by the ticks rule of the radius axis."
            },
            "fill": {
              "type": "boolean",
              "default": true,
              "description": "Whether each series draws its polygon as a filled area over its stroke. Without it, true."
            },
            "legend_position": {
              "enum": [
                "top",
                "right",
                "bottom",
                "left",
                "none"
              ],
              "default": "bottom",
              "description": "none hides the legend, which one series never shows. Without it, bottom."
            },
            "drill_down": {
              "type": "boolean",
              "default": false,
              "description": "Whether the chart offers its data view and opens it from a click on a spoke. Without it, false."
            }
          }
        }
      ],
      "unevaluatedProperties": false
    },
    {
      "$id": "gts://gts.frontx.dashboard.widget.widget.v1~frontx.dashboard.widget.data_widget.v1~frontx.dashboard.widget.radar_chart.v1~",
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "title": "RadarChart",
      "x-gts-traits": {
        "entry": "gts.frontx.mfes.mfe.entry.v1~frontx.mfes.mfe.entry_mf.v1~frontx.dashboard.mfe.radar_chart.v1",
        "data_type": "gts.frontx.dashboard.widget_data.widget_data.v1~frontx.dashboard.widget_data.radar_chart.v1~"
      },
      "allOf": [
        {
          "$ref": "gts://gts.frontx.dashboard.widget.widget.v1~frontx.dashboard.widget.data_widget.v1~"
        },
        {
          "type": "object",
          "properties": {
            "render": {
              "$ref": "gts://gts.frontx.dashboard.widget.render.v1~frontx.dashboard.widget.radar_chart_render.v1~"
            }
          }
        }
      ],
      "unevaluatedProperties": false
    }
  ]
