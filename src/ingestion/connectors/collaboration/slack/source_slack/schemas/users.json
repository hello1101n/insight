{
  "type": "object",
  "$schema": "http://json-schema.org/draft-07/schema#",
  "description": "Slack members from users.list, one row per member. The connector keeps only these fields and drops all other profile fields. Source fields are [type, \"null\"]: the destination stores NULL for a value it cannot convert and records it in _airbyte_meta.",
  "properties": {
    "unique_key": {
      "type": "string"
    },
    "insight_tenant_id": {
      "type": "string"
    },
    "insight_source_id": {
      "type": "string"
    },
    "user_id": {
      "type": "string"
    },
    "real_name": {
      "type": [
        "string",
        "null"
      ]
    },
    "display_name": {
      "type": [
        "string",
        "null"
      ]
    },
    "deleted": {
      "type": [
        "boolean",
        "null"
      ]
    },
    "email": {
      "type": [
        "string",
        "null"
      ]
    },
    "is_restricted": {
      "type": [
        "boolean",
        "null"
      ]
    },
    "is_ultra_restricted": {
      "type": [
        "boolean",
        "null"
      ]
    },
    "is_bot": {
      "type": [
        "boolean",
        "null"
      ]
    }
  },
  "required": [
    "unique_key",
    "insight_tenant_id",
    "insight_source_id",
    "user_id"
  ],
  "additionalProperties": true
}
